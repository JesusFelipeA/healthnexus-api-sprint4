# Desarrollo con Docker: copia este archivo como .env.docker
PORT=3000
DB_HOST=db
DB_PORT=3306
DB_USER=hn_app
DB_PASS=hn_dev_pass
DB_NAME=healthnexusdb
JWT_SECRET=clave_solo_para_desarrollo_cambiala
JWT_EXPIRES=8h
CORS_ORIGINS=http://localhost:5173,http://localhost,https://localhost
TRUST_PROXY=0
RATE_LIMIT_MAX=120
# Notificaciones push (opcional): guarda el JSON de la cuenta de servicio en la carpeta secrets/
# (ignorada por git) y descomenta la línea. La ruta es la de dentro del contenedor.
# FIREBASE_CREDENTIALS_FILE=/app/secrets/cuenta-de-servicio.json
FIREBASE_CREDENTIALS_FILE=
