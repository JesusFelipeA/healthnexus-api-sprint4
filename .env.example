PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=healthnexusdb
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES=8h
# Orígenes permitidos (separados por coma). Capacitor Android usa https://localhost
CORS_ORIGINS=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost
# 0 = no confiar en X-Forwarded-For (recomendado). Usa 1 solo si la API está detrás de UN proxy (Nginx, Azure App Service...)
TRUST_PROXY=0
# Peticiones por minuto y por IP antes de responder 429 (120 por defecto)
RATE_LIMIT_MAX=120
# Notificaciones push (opcional): ruta al JSON de la cuenta de servicio de Firebase (fuera del repo)
FIREBASE_CREDENTIALS_FILE=
# Recuperación de contraseña desde la app (código de 6 dígitos por correo). Ejemplo con Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu-cuenta@gmail.com  SMTP_PASS=<contraseña de aplicación de 16 letras>
# Sin SMTP_HOST: en desarrollo el código se imprime en la consola de la API; en producción no se envía.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HealthNexus <no-responder@healthnexus.duckdns.org>
