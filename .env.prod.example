# Producción o staging: copia como .env.prod / .env.qa en el SERVIDOR (chmod 600). Nunca lo subas a Git.
# Usa valores distintos en cada ambiente. Genera secretos con:  openssl rand -hex 32
DB_USER=hn_app
DB_PASS=CAMBIAME_contraseña_aleatoria
DB_ROOT_PASS=CAMBIAME_otra_contraseña_aleatoria
DB_NAME=healthnexusdb
JWT_SECRET=CAMBIAME_64_caracteres_aleatorios
JWT_EXPIRES=8h
CORS_ORIGINS=https://healthnexus.duckdns.org
TRUST_PROXY=1
RATE_LIMIT_MAX=120
# Notificaciones push (opcional). Cuenta de servicio de Firebase codificada en base64:
#   base64 -w0 cuenta-de-servicio.json
# Déjalo vacío para desactivarlas. Es un secreto: igual que DB_PASS.
FIREBASE_CREDENTIALS_BASE64=
# Recuperación de contraseña desde la app (código de 6 dígitos por correo). Ejemplo con Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu-cuenta@gmail.com  SMTP_PASS=<contraseña de aplicación de 16 letras>
# Sin SMTP_HOST: en desarrollo el código se imprime en la consola de la API; en producción no se envía.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HealthNexus <no-responder@healthnexus.duckdns.org>
