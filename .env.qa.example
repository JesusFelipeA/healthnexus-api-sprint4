# Staging / QA: copia como .env.qa EN EL SERVIDOR DE QA (chmod 600). Nunca lo subas a Git.
# Se usa con:  docker compose -f docker-compose.prod.yml --env-file .env.qa up -d --build
# Base MySQL propia en Docker con datos FICTICIOS (scripts/crear-usuarios-qa.js). Nunca apuntes QA a RDS.
# Todos los secretos deben ser DISTINTOS a los de producción. Genera cada uno con:  openssl rand -hex 32
DB_USER=hn_app
DB_PASS=CAMBIAME_contraseña_aleatoria_qa
DB_ROOT_PASS=CAMBIAME_otra_contraseña_aleatoria_qa
DB_NAME=healthnexusdb
JWT_SECRET=CAMBIAME_64_caracteres_aleatorios_qa
JWT_EXPIRES=8h
CORS_ORIGINS=https://qa-healthnexus.duckdns.org
TRUST_PROXY=1
RATE_LIMIT_MAX=120
# Notificaciones push (opcional). Cuenta de servicio de Firebase codificada en base64:
#   base64 -w0 cuenta-de-servicio.json
# Déjalo vacío para desactivarlas. Es un secreto: igual que DB_PASS.
FIREBASE_CREDENTIALS_BASE64=
