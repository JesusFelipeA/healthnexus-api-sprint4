# Producción con Amazon RDS: copia como .env.rds EN EL SERVIDOR y protégelo (chmod 600). Nunca lo subas a Git.
# Recomendado: no lo edites a mano, genéralo desde SSM con  ./scripts/env-desde-ssm.sh prod .env.rds
# DB_USER: usuario solo para la API (database/usuario-api.sql), no admin.
DB_HOST=tu-instancia.xxxxxxxx.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=healthnexusdb
DB_USER=hn_api
DB_PASS=CAMBIAME
# Si no tienes uno, genéralo con:  openssl rand -hex 32   (cambiarlo cierra todas las sesiones abiertas)
JWT_SECRET=CAMBIAME_64_caracteres_aleatorios
JWT_EXPIRES=8h
CORS_ORIGINS=https://healthnexus.duckdns.org
# Nginx está delante de la API: 1 para leer la IP real del cliente
TRUST_PROXY=1
RATE_LIMIT_MAX=120
# Notificaciones push (opcional). Cuenta de servicio de Firebase codificada en base64:
#   base64 -w0 cuenta-de-servicio.json
# Déjalo vacío para desactivarlas. Es un secreto: igual que DB_PASS.
FIREBASE_CREDENTIALS_BASE64=
