{
  "title": "HealthNexus API",
  "uid": "healthnexus-api",
  "tags": [
    "healthnexus"
  ],
  "timezone": "America/Mexico_City",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "description": "Rendimiento de la API (peticiones, errores, latencia), trazas y el servidor EC2. Sin datos de pacientes.",
  "templating": {
    "list": [
      {
        "name": "ds_metricas",
        "label": "Métricas",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "ds_trazas",
        "label": "Trazas",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Servicio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_metricas}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{job=~\".*healthnexus-api\"}, job)",
          "refId": "q"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{job=~\".*healthnexus-api\"}, job)",
        "refresh": 2,
        "current": {
          "text": "healthnexus/healthnexus-api",
          "value": "healthnexus/healthnexus-api"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API: lo que ven los usuarios",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Peticiones por minuto",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"$job\"}[$__rate_interval])) * 60",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errores del servidor (5xx)",
      "description": "Porcentaje de respuestas 500-599. Más de 1 % es para revisar.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"$job\",http_response_status_code=~\"5..\"}[$__rate_interval]) or vector(0))) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"$job\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latencia p95",
      "description": "95 % de las respuestas tardan menos que esto. El criterio de la prueba de carga es 800 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Rechazos 401 / 403 / 429",
      "description": "Sesiones vencidas, permisos y límite de peticiones. Un pico de 429 indica que el límite por IP se quedó corto.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"$job\",http_response_status_code=~\"401|403|429\"}[$__rate_interval]) or vector(0))) * 60",
          "legendFormat": "__auto"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Peticiones por ruta",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"$job\"}[$__rate_interval])) * 60",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latencia p95 por ruta",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Respuestas por código",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"$job\"}[$__rate_interval])) * 60",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Rutas más lentas (p95 en el periodo)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, http_route, http_request_method) (rate(http_server_request_duration_seconds_bucket{job=\"$job\"}[$__range]))))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "http_route": "Ruta",
              "http_request_method": "Método",
              "Value": "p95"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "p95",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Trazas: el detalle de una petición",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Peticiones con error",
      "description": "Clic en una traza para ver en qué paso falló (Express, consulta SQL).",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_trazas}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_trazas}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"healthnexus-api\" && status=error}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Peticiones lentas (más de 800 ms)",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_trazas}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_trazas}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"healthnexus-api\" && kind=server && duration>800ms}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Consultas SQL lentas (más de 200 ms)",
      "description": "Las consultas aparecen con los valores cambiados por ?: nunca llevan datos de pacientes.",
      "datasource": {
        "type": "tempo",
        "uid": "${ds_trazas}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${ds_trazas}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"healthnexus-api\" && kind=client && duration>200ms}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Servidor EC2",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"integrations/unix\",mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "CPU usada"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Memoria",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "node_memory_MemTotal_bytes{job=\"integrations/unix\"} - node_memory_MemAvailable_bytes{job=\"integrations/unix\"}",
          "legendFormat": "Usada"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "node_memory_MemTotal_bytes{job=\"integrations/unix\"}",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Disco usado",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metricas}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metricas}"
          },
          "expr": "1 - node_filesystem_avail_bytes{job=\"integrations/unix\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"integrations/unix\",fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}